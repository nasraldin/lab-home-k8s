# Single-lab inventory — ID = last octet in 1xx range (aligned 2026-07-30).
# Jumpbox is ssh-01 (.12); AdGuard starts at .14; PVE fixed at .13.

proxmox_endpoint = "https://192.168.68.13:8006/"
node_name        = "pve01"

network_gateway = "192.168.68.1"
network_bridge  = "vmbr0"
vm_datastore    = "data01"

default_username = "nasr"
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH9wRDs8478+qe0aQk1Cfwv98FHoByrmWLP63Rngbn/G pve01.lab.nasraldin.com"

zfs_pools = {
  data01 = {
    device = "/dev/disk/by-id/nvme-KINGSTON_SFYRD4000G_50026B76871D1F07"
  }
}

pools = {}

cloud_images = {
  debian-13 = {
    url       = "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
    file_name = "debian-13-genericcloud-amd64.qcow2"
  }
}

lxc_templates = {
  debian-13 = {
    url       = "http://download.proxmox.com/images/system/debian-13-standard_13.1-2_amd64.tar.zst"
    file_name = "debian-13-standard_13.1-2_amd64.tar.zst"
  }
  "ubuntu-24.04" = {
    url       = "http://download.proxmox.com/images/system/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
    file_name = "ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
  }
}

vms = {
  gitlab-01 = {
    image         = "debian-13"
    tags          = ["gitlab", "core", "debian"]
    vm_id         = 115
    cores         = 4
    memory        = 12288
    disk_gb       = 150
    ip            = "192.168.68.15/22"
    startup_order = 4
  }
  runner-01 = {
    image         = "debian-13"
    tags          = ["ci", "core", "debian"]
    vm_id         = 116
    cores         = 2
    memory        = 4096
    disk_gb       = 40
    ip            = "192.168.68.16/22"
    startup_order = 5
  }
  k8s-cp-01 = {
    image         = "debian-13"
    tags          = ["k8s", "control-plane", "debian"]
    vm_id         = 117
    cores         = 2
    memory        = 6144
    disk_gb       = 40
    ip            = "192.168.68.17/22"
    startup_order = 6
  }
  # data_disk_gb = Longhorn store (scsi1 → /var/lib/longhorn). 700 GiB × 3 ≈ 2 TiB
  # raw cluster capacity on data01 (ZFS thin). Grow later with: qm resize <vmid> scsi1 Ng
  k8s-w-01 = {
    image         = "debian-13"
    tags          = ["k8s", "worker", "debian"]
    vm_id         = 118
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.18/22"
    startup_order = 7
  }
  k8s-w-02 = {
    image         = "debian-13"
    tags          = ["k8s", "worker", "debian"]
    vm_id         = 119
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.19/22"
    startup_order = 8
  }
  k8s-w-03 = {
    image         = "debian-13"
    tags          = ["k8s", "worker", "debian"]
    vm_id         = 120
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.20/22"
    startup_order = 9
  }
  docker-01 = {
    image         = "debian-13"
    tags          = ["docker", "apps", "core", "debian"]
    vm_id         = 121
    cores         = 2
    memory        = 8192
    disk_gb       = 120
    ip            = "192.168.68.21/22"
    startup_order = 10
  }
  # ai-01 (VM 120) destroyed 2026-07-30 — Ollama primary is LXC llm-01 (.26).
}

# Kept for rollback to VFIO VM path; llm-01 uses LXC device passthrough instead.
# Host must NOT bind this GPU to vfio-pci while llm-01 runs (amdgpu on host).
pci_mappings = {
  ai-igpu = {
    id            = "1002:150e" # verify: lspci -nn -s c6:00.0
    subsystem_id  = "1f4c:b020"
    path          = "0000:c6:00.0"
    iommu_group   = 22
    comment       = "Radeon 890M iGPU — reserved mapping; LXC llm-01 is active path"
  }
}

containers = {
  # Authoritative DNS — ID matches last octet (.11)
  dns-01 = {
    template     = "debian-13"
    tags         = ["dns", "technitium", "core"]
    vm_id        = 111
    cores        = 1
    memory       = 512
    disk_gb      = 10
    ip           = "192.168.68.11/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Jumpbox — SSH + operator tools only (formerly infra-01)
  ssh-01 = {
    template     = "debian-13"
    tags         = ["ssh", "jumpbox", "core"]
    vm_id        = 112
    cores        = 2
    memory       = 2048
    disk_gb      = 20
    ip           = "192.168.68.12/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Recursive DNS + filtering — AdGuard starts at .14 (PVE is .13)
  adguard-01 = {
    template     = "debian-13"
    tags         = ["dns", "adguard", "core"]
    vm_id        = 114
    cores        = 1
    memory       = 512
    disk_gb      = 10
    ip           = "192.168.68.14/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Infisical + local Postgres/Redis (official Compose; nesting for Docker)
  infisical-01 = {
    template     = "debian-13"
    tags         = ["infisical", "secrets", "core"]
    vm_id        = 125
    cores        = 2
    memory       = 4096
    disk_gb      = 40
    ip           = "192.168.68.25/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Ollama + ROCm userspace — privileged for /dev/dri + /dev/kfd.
  # Host prep: scripts/host-igpu-for-lxc.sh then reboot (no live VFIO→amdgpu bind).
  # Docs: ../../docs/operations/ollama-llm-01.md
  llm-01 = {
    template     = "ubuntu-24.04"
    tags         = ["ai", "ollama", "gpu", "llm"]
    vm_id        = 126
    cores        = 8
    memory       = 24576
    disk_gb      = 100
    ip           = "192.168.68.26/22"
    unprivileged = false
    os_type      = "ubuntu"
    device_passthrough = [
      { path = "/dev/dri/renderD128", gid = 44, mode = "0666" },
      { path = "/dev/dri/card1", gid = 44, mode = "0666" },
      { path = "/dev/kfd", gid = 993, mode = "0666" },
    ]
  }
}

backup_storage_enabled = true
backup_storage_id      = "local-backup"
backup_storage_path    = "/var/lib/vz/backups"

backup_jobs = {
  daily-all = {
    schedule         = "*-*-* 02:00"
    mode             = "snapshot"
    compress         = "zstd"
    all              = true
    mailnotification = "failure"
    prune_backups = {
      keep-daily   = "7"
      keep-weekly  = "4"
      keep-monthly = "3"
    }
  }
}
