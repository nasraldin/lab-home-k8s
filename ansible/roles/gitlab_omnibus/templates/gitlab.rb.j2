# GitLab Omnibus — generated by ansible-lab. Do not edit by hand.
# TLS terminates at Cloudflare Tunnel; nginx serves HTTP on :{{ gitlab_listen_port }}.

external_url '{{ gitlab_external_url }}'

# GitLab 19+ prefers nested nginx keys; keep LE off (TLS at Cloudflare Tunnel).
gitlab_rails['nginx']['listen_port'] = {{ gitlab_listen_port }}
gitlab_rails['nginx']['listen_https'] = false
gitlab_rails['nginx']['redirect_http_to_https'] = false
letsencrypt['enable'] = false

gitlab_rails['initial_root_password'] = '{{ gitlab_root_password }}'
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_keep_time }}

puma['worker_processes'] = {{ gitlab_puma_worker_processes }}
sidekiq['max_concurrency'] = {{ gitlab_sidekiq_max_concurrency }}

# Keep bundled Prometheus/Grafana off — scrape exporters from monitoring-01.
prometheus_monitoring['enable'] = {{ gitlab_prometheus_enable | lower }}
node_exporter['enable'] = false
redis_exporter['enable'] = false
postgres_exporter['enable'] = false

gitlab_exporter['enable'] = {{ gitlab_exporter_enable | lower }}
gitlab_exporter['listen_address'] = '{{ gitlab_exporter_listen_address }}'

gitlab_workhorse['prometheus_listen_addr'] = '{{ gitlab_workhorse_prometheus_listen_addr }}'

sidekiq['metrics_enabled'] = {{ gitlab_sidekiq_metrics_enabled | lower }}
sidekiq['listen_address'] = '{{ gitlab_sidekiq_listen_address }}'
sidekiq['listen_port'] = {{ gitlab_sidekiq_listen_port }}

# Nested Omnibus config (legacy gitaly['prometheus_listen_addr'] stays localhost on GitLab 18+)
gitaly['configuration'] = {
  'prometheus_listen_addr' => '{{ gitlab_gitaly_prometheus_listen_addr }}',
}

# Container Registry — public HTTPS via Cloudflare Tunnel (registry.nasraldin.com)
registry_external_url '{{ gitlab_registry_external_url }}'
gitlab_rails['registry_enabled'] = {{ gitlab_registry_enabled | lower }}
registry['nginx']['listen_port'] = {{ gitlab_registry_listen_port }}
registry['nginx']['listen_https'] = false
registry['nginx']['redirect_http_to_https'] = false
registry['debug_addr'] = '{{ gitlab_registry_debug_addr }}'

{% if gitlab_object_store_enabled | bool %}
# Object storage → shared AIStor Free (aistor-01)
gitlab_rails['object_store']['enabled'] = true
gitlab_rails['object_store']['connection'] = {
  'provider' => 'AWS',
  'region' => 'us-east-1',
  'endpoint' => '{{ gitlab_object_store_endpoint }}',
  'path_style' => true,
  'aws_access_key_id' => '{{ gitlab_object_store_access_key }}',
  'aws_secret_access_key' => '{{ gitlab_object_store_secret_key }}'
}
gitlab_rails['object_store']['objects']['artifacts']['bucket'] = 'gitlab-artifacts'
gitlab_rails['object_store']['objects']['lfs']['bucket'] = 'gitlab-lfs'
gitlab_rails['object_store']['objects']['uploads']['bucket'] = 'gitlab-uploads'
gitlab_rails['object_store']['objects']['packages']['bucket'] = 'gitlab-packages'
gitlab_rails['object_store']['objects']['dependency_proxy']['bucket'] = 'gitlab-dependency-proxy'
gitlab_rails['object_store']['objects']['terraform_state']['bucket'] = 'gitlab-terraform-state'
gitlab_rails['object_store']['objects']['ci_secure_files']['bucket'] = 'gitlab-ci-secure-files'
gitlab_rails['object_store']['objects']['pages']['bucket'] = 'gitlab-pages'
gitlab_rails['object_store']['objects']['external_diffs']['bucket'] = 'gitlab-external-diffs'

registry['storage'] = {
  's3' => {
    'accesskey' => '{{ gitlab_object_store_access_key }}',
    'secretkey' => '{{ gitlab_object_store_secret_key }}',
    'bucket' => 'gitlab-registry',
    'region' => 'us-east-1',
    'regionendpoint' => '{{ gitlab_object_store_endpoint }}',
    'pathstyle' => true
  }
}
registry['storage_delete']['enabled'] = true
{% endif %}
