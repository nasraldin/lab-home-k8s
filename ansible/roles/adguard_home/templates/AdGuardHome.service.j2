[Unit]
Description=AdGuard Home
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{ adguard_install_dir }}
ExecStart={{ adguard_install_dir }}/AdGuardHome -c {{ adguard_install_dir }}/AdGuardHome.yaml -w {{ adguard_install_dir }} --no-check-update
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
