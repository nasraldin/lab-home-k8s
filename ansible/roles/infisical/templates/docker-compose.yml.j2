# Infisical on {{ inventory_hostname }} — official Compose shape (backend + Postgres + Redis).
# Lab optimisations: pinned image, Postgres 16, Redis with AOF + password, tuned shared_buffers.
# Host port {{ infisical_http_port }} (NPM on docker-01 owns :80/:443).

services:
  backend:
    container_name: infisical-backend
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    image: {{ infisical_image }}:{{ infisical_image_tag }}
    pull_policy: always
    env_file: .env
    ports:
      - "{{ infisical_http_port }}:8080"
    environment:
      - NODE_ENV=production
    networks:
      - infisical

  db:
    image: {{ infisical_postgres_image }}
    container_name: infisical-db
    restart: unless-stopped
    env_file: .env
    command:
      - postgres
      - -c
      - shared_buffers={{ infisical_postgres_shared_buffers }}
      - -c
      - max_connections={{ infisical_postgres_max_connections }}
      - -c
      - effective_cache_size={{ infisical_postgres_effective_cache_size }}
      - -c
      - checkpoint_completion_target=0.9
      - -c
      - wal_buffers=16MB
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ infisical_postgres_user }} -d {{ infisical_postgres_db }}"]
      interval: 5s
      timeout: 5s
      retries: 12
    networks:
      - infisical
    volumes:
      - pg_data:/var/lib/postgresql/data

  redis:
    image: {{ infisical_redis_image }}
    container_name: infisical-redis
    restart: unless-stopped
    command:
      - redis-server
      - --requirepass
      - {{ infisical_redis_password }}
      - --appendonly
      - "yes"
      - --maxmemory
      - {{ infisical_redis_maxmemory }}
      - --maxmemory-policy
      - allkeys-lru
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a {{ infisical_redis_password }} ping | grep PONG"]
      interval: 5s
      timeout: 5s
      retries: 12
    networks:
      - infisical
    volumes:
      - redis_data:/data

volumes:
  pg_data:
    driver: local
  redis_data:
    driver: local

networks:
  infisical:
