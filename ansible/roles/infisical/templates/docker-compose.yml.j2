# Infisical on infra-01 — local Postgres + Redis.
# Host port is {{ infisical_http_port }} (NPM owns :80/:443 on docker-01).

services:
  backend:
    container_name: infisical-backend
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    image: {{ infisical_image }}:{{ infisical_image_tag }}
    pull_policy: always
    env_file: .env
    ports:
      - "{{ infisical_http_port }}:8080"
    environment:
      - NODE_ENV=production
    networks:
      - proxy
      - infisical

  db:
    image: {{ infisical_postgres_image }}
    container_name: infisical-db
    restart: unless-stopped
    env_file: .env
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ infisical_postgres_user }} -d {{ infisical_postgres_db }}"]
      interval: 5s
      timeout: 5s
      retries: 12
    networks:
      - infisical
    volumes:
      - pg_data:/var/lib/postgresql/data

  redis:
    image: {{ infisical_redis_image }}
    container_name: infisical-redis
    restart: unless-stopped
    env_file: .env
    environment:
      - ALLOW_EMPTY_PASSWORD=yes
    networks:
      - infisical
    volumes:
      - redis_data:/data

volumes:
  pg_data:
    driver: local
  redis_data:
    driver: local

networks:
  infisical:
  proxy:
    external: true
    name: proxy
