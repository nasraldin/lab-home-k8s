services:
  portainer:
    image: {{ portainer_image }}
    container_name: portainer
    restart: unless-stopped
    # bcrypt hash — doubles $$ so Compose does not interpolate. Avoids the
    # 5-minute admin init timeout on first boot.
    command:
      - --admin-password
      - {{ portainer_admin_password_hash | replace('$', '$$') }}
    ports:
      - "{{ portainer_https_port }}:9443"
      - "{{ portainer_edge_port }}:8000"
    environment:
      PORTAINER_PUBLIC_URL: "{{ portainer_public_url }}"
    volumes:
      - portainer_data:/data
      - /var/run/docker.sock:/var/run/docker.sock

volumes:
  portainer_data:
