# Generated by Ansible — do not commit. Mode 0600 on host.
# Back up ENCRYPTION_KEY offline / into Vault infra/ — without it DB is unrecoverable.

ENCRYPTION_KEY={{ infisical_encryption_key }}
AUTH_SECRET={{ infisical_auth_secret }}

POSTGRES_USER={{ infisical_postgres_user }}
POSTGRES_PASSWORD={{ infisical_postgres_password }}
POSTGRES_DB={{ infisical_postgres_db }}

# Central Postgres via PgCat on database-01
DB_CONNECTION_URI=postgres://{{ infisical_postgres_user }}:{{ infisical_postgres_password }}@{{ infisical_pg_host }}:{{ infisical_pg_port }}/{{ infisical_postgres_db }}
REDIS_URL=redis://redis:6379

SITE_URL={{ infisical_site_url }}

{% if infisical_smtp_host | length > 0 %}
SMTP_HOST={{ infisical_smtp_host }}
SMTP_PORT={{ infisical_smtp_port }}
SMTP_USERNAME={{ infisical_smtp_username }}
SMTP_PASSWORD={{ infisical_smtp_password }}
SMTP_FROM_ADDRESS={{ infisical_smtp_from_address }}
SMTP_FROM_NAME={{ infisical_smtp_from_name }}
{% endif %}
