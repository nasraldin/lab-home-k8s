# CI profile: keep syntax/load errors fatal; defer style cleanup.
profile: min
skip_list:
  - var-naming
  - no-changed-when
  - yaml[line-length]
  - yaml[empty-lines]
  - name[casing]
  - name[missing]
  - risky-file-permissions
  - risky-shell-pipe
  - command-instead-of-shell
  - jinja[spacing]
