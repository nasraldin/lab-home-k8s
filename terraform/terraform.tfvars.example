# VMIDs packed 111–120: CTs 111–113, VMs 114–120.
# Infisical .15 / GitLab .25 (PVE stays .10, AdGuard stays .14).

proxmox_endpoint = "https://192.168.68.10:8006/"
node_name        = "pve01"

network_gateway = "192.168.68.1"
network_bridge  = "vmbr0"
vm_datastore    = "data01"

default_username = "nasr"
ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH9wRDs8478+qe0aQk1Cfwv98FHoByrmWLP63Rngbn/G pve01.lab.nasraldin.com"

zfs_pools = {
  data01 = {
    device = "/dev/disk/by-id/nvme-KINGSTON_SFYRD4000G_50026B76871D1F07"
  }
}

pools = {}

cloud_images = {
  debian-13 = {
    url       = "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
    file_name = "debian-13-genericcloud-amd64.qcow2"
  }
}

lxc_templates = {
  debian-13 = {
    url       = "http://download.proxmox.com/images/system/debian-13-standard_13.1-2_amd64.tar.zst"
    file_name = "debian-13-standard_13.1-2_amd64.tar.zst"
  }
}

vms = {
  gitlab-01 = {
    image         = "debian-13"
    vm_id         = 114
    cores         = 4
    memory        = 12288
    disk_gb       = 150
    ip            = "192.168.68.25/22"
    startup_order = 4
  }
  runner-01 = {
    image         = "debian-13"
    vm_id         = 115
    cores         = 2
    memory        = 4096
    disk_gb       = 40
    ip            = "192.168.68.16/22"
    startup_order = 5
  }
  k8s-cp-01 = {
    image         = "debian-13"
    vm_id         = 116
    cores         = 2
    memory        = 6144
    disk_gb       = 40
    ip            = "192.168.68.17/22"
    startup_order = 6
  }
  # data_disk_gb = Longhorn store (scsi1 → /var/lib/longhorn). 700 GiB × 3 ≈ 2 TiB
  # raw cluster capacity on data01 (ZFS thin). Grow later with: qm resize <vmid> scsi1 Ng
  k8s-w-01 = {
    image         = "debian-13"
    vm_id         = 117
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.18/22"
    startup_order = 7
  }
  k8s-w-02 = {
    image         = "debian-13"
    vm_id         = 118
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.19/22"
    startup_order = 8
  }
  k8s-w-03 = {
    image         = "debian-13"
    vm_id         = 119
    cores         = 4
    memory        = 12288
    disk_gb       = 60
    data_disk_gb  = 700
    ip            = "192.168.68.20/22"
    startup_order = 9
  }
  docker-01 = {
    image         = "debian-13"
    vm_id         = 120
    cores         = 2
    memory        = 8192
    disk_gb       = 120
    ip            = "192.168.68.21/22"
    startup_order = 10
  }
  # Destroyed: ai-01, ssh-01, llm-01. IDs compacted to 111–120 on 2026-09-12.
}

pci_mappings = {}

containers = {
  # Authoritative DNS
  dns-01 = {
    template     = "debian-13"
    vm_id        = 111
    cores        = 1
    memory       = 512
    disk_gb      = 10
    ip           = "192.168.68.11/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Recursive DNS + filtering — IP stays .14 (PVE is .10)
  adguard-01 = {
    template     = "debian-13"
    vm_id        = 112
    cores        = 1
    memory       = 512
    disk_gb      = 10
    ip           = "192.168.68.14/22"
    unprivileged = true
    os_type      = "debian"
  }
  # Infisical + local Postgres/Redis (official Compose; nesting for Docker)
  infisical-01 = {
    template     = "debian-13"
    vm_id        = 113
    cores        = 2
    memory       = 4096
    disk_gb      = 40
    ip           = "192.168.68.15/22"
    unprivileged = true
    os_type      = "debian"
  }
}

backup_storage_enabled = true
backup_storage_id      = "local-backup"
backup_storage_path    = "/var/lib/vz/backups"

backup_jobs = {
  daily-all = {
    schedule         = "*-*-* 02:00"
    mode             = "snapshot"
    compress         = "zstd"
    all              = true
    mailnotification = "failure"
    prune_backups = {
      keep-daily   = "7"
      keep-weekly  = "4"
      keep-monthly = "3"
    }
  }
}
